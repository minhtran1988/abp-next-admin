[
  {
    "WorkflowName": "TestMultipleRuleInputValidation",
    "Rules": [
      {
        "RuleName": "ValidationInputField",
        "ErrorMessage": "Invalid input field validation!",
        "ErrorType": "Error",
        "Operator": "AndAlso",
        "Rules": [
          {
            "RuleName": "InputRequired",
            "ErrorMessage": "Field Required must be entered!",
            "ErrorType": "Error",
            "RuleExpressionType": "LambdaExpression",
            "Expression": "!string.IsNullOrWhiteSpace(input1.Required)"
          },
          {
            "RuleName": "MustBeGreaterThan100",
            "ErrorMessage": "Field Integer1 must be greater than 100!",
            "ErrorType": "Error",
            "RuleExpressionType": "LambdaExpression",
            "Expression": "input1.Integer1 > 100"
          },
          {
            "RuleName": "MustBeLessThan100",
            "ErrorMessage": "Field Integer2 must be less than 100!",
            "ErrorType": "Error",
            "RuleExpressionType": "LambdaExpression",
            "Expression": "input1.Integer2 < 100"
          }
        ]
      },
      {
        "RuleName": "ValidationLengthAndSum",
        "ErrorMessage": "Length and sum verification are invalid!",
        "ErrorType": "Error",
        "Operator": "AndAlso",
        "Rules": [
          {
            "RuleName": "SumMustBeGreaterThan150",
            "ErrorMessage": "The sum of fields Integer1 and Integer2 must be greater than 200!",
            "ErrorType": "Error",
            "RuleExpressionType": "LambdaExpression",
            "Expression": "input1.Integer1 + input1.Integer2 > 200"
          },
          {
            "RuleName": "RequiredLengthMustBeGreaterThan5",
            "ErrorMessage": "Field Length length must be greater than 5!",
            "ErrorType": "Error",
            "RuleExpressionType": "LambdaExpression",
            "Expression": "input1.Length.Length > 5"
          }
        ]
      }
    ]
  }
]