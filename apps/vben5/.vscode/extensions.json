{
  "recommendations": [
    // Vue 3 language support
    "Vue.volar",
    // Integrate ESLint JavaScript into VS Code.
    "dbaeumer.vscode-eslint",
    // Official Stylelint extension for Visual Studio Code
    "stylelint.vscode-stylelint",
    // Code formatter using Prettier
    "esbenp.prettier-vscode",
    // Support dotenv file syntax
    "mikestead.dotenv",
    // Spell checker for source code
    "streetsidesoftware.code-spell-checker",
    // Official Tailwind CSS VS Code extension
    "bradlc.vscode-tailwindcss",
    // iconify icon extension
    "antfu.iconify",
    // i18n extension
    "Lokalise.i18n-ally",
    // CSS variable suggestions
    "vunguyentuan.vscode-css-variables",
    // Show PNPM catalog versions in package.json
    "antfu.pnpm-catalog-lens"
  ],
  "unwantedRecommendations": [
    // Conflicts with Volar
    "octref.vetur"
  ]
}
