# port number
VITE_PORT=5666

VITE_BASE=/

#Interface address
VITE_GLOB_API_URL=/

# Whether to enable Nitro Mock service, true means open, false means closed
VITE_NITRO_MOCK=false

# Whether to open devtools, true means open, false means closed
VITE_DEVTOOLS=false

# Whether to inject global loading
VITE_INJECT_APP_LOADING=true

# Whether to only allow OIDC login
VITE_GLOB_AUTH_ONLY_OIDC=true
# Authentication server
VITE_GLOB_AUTH_AUTHORITY="http://localhost:30000"
# Authorization scope
VITE_GLOB_AUTH_AUDIENCE="openid email address phone profile offline_access lingyun-abp-application"
#ClientId
VITE_GLOB_AUTH_CLIENT_ID=vue-admin-client
# Client key [Do not set this value in the production environment. It is recommended to enable only OIDC login, and the authorization code type will be used to log in]
VITE_GLOB_AUTH_CLIENT_SECRET=1q2w3e*
# Optional values: login, consent, select_account
# Uncomment selecting accounts in multi-tenants when logging in
# VITE_GLOB_AUTH_PROMPT=select_account
# Uncomment to force the user to enter credentials on this request when logging in, disabling single sign-on
# VITE_GLOB_AUTH_PROMPT=login
# Uncomment always require user authorization when logging in
# VITE_GLOB_AUTH_PROMPT=consent
