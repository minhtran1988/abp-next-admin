VITE_BASE=/

#Interface address
VITE_GLOB_API_URL=https://mock-napi.vben.pro/api

# Whether to enable compression, can be set to none, brotli, gzip
VITE_COMPRESS=none

# Whether to enable PWA
VITE_PWA=false

# vue-router mode
# The oauth2.0 protocol requires that the callback must be a complete URL
# VITE_ROUTER_HISTORY=hash

# Whether to inject global loading
VITE_INJECT_APP_LOADING=true

# Whether to generate dist.zip after packaging
VITE_ARCHIVER=true

# Whether to only allow OIDC login
VITE_GLOB_AUTH_ONLY_OIDC=false

# Authentication server
VITE_GLOB_AUTH_AUTHORITY="http://127.0.0.1:30001"

# Authorization scope
VITE_GLOB_AUTH_AUDIENCE="openid email address phone profile offline_access lingyun-abp-application"

#ClientId
VITE_GLOB_AUTH_CLIENT_ID=vue-oauth-client
